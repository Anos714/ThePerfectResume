# Frontend environment variables
# Copy to .env.local and fill in real values.

# The Hono backend origin. Must be a full URL including the port in dev.
# The backend's CORS allowlist (FRONTEND_URL) must match the browser origin.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Google OAuth (optional). Leave NEXT_PUBLIC_GOOGLE_CLIENT_ID empty to hide the
# "Continue with Google" button. NEXT_PUBLIC_GOOGLE_REDIRECT_URI must match the
# backend's GOOGLE_REDIRECT_URI and the authorised redirect in the Google
# console; the callback route is /auth/google/callback.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
