{
  "name": "backend",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "build": "bun run typecheck && bun build ./src/server.ts --outdir ./dist --target bun",
    "start": "bun .dist/server.js",
    "typeCheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "hono": "^4.13.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.12"
  }
}
